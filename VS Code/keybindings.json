// Place your key bindings in this file to override the defaults
[
    {
        "key": "ctrl+alt+r",
        "command": "r.createRTerm"
    },
    {
        "key": "ctrl+m",
        "command": "-editor.action.toggleTabFocusMode"
    },
    {
        "key": "ctrl+1",
        "command": "workbench.action.terminal.focus",
        "when": "editorTextFocus"
    },
    {
        "key": "ctrl+1",
        "command": "workbench.action.focusActiveEditorGroup",
        "when": "terminalFocus"
    },
    {
        "key": "ctrl+shift+m",
        "command": "rPipeIndent.insertPipe",
        "when": "editorTextFocus && editorLangId == r && !editorReadonly"
    },
    {
        "key": "ctrl+numpad4",
        "command": "claude-vscode.primaryEditor.open"
    },
    {
        "key": "ctrl+numpad4",
        "command": "chatOpener.newChatHere",
        "when": "chatOpener.ready"
    },
    {
        "key": "ctrl+numpad5",
        "command": "claude-vscode.sidebar.open"
    },
    {
        "key": "ctrl+numpad5",
        "command": "wordPage.editorSelectionToClaude",
        "when": "editorTextFocus && editorHasSelection"
    },
    {
        "key": "ctrl+numpad5",
        "command": "wordPage.selectionToClaude",
        "when": "activeCustomEditorId == 'quarto.visualEditor' && !sideBarFocus && !auxiliaryBarFocus && !panelFocus"
    },
    {
        "key": "ctrl+numpad5",
        "command": "wordPage.browserToClaude",
        "when": "activeEditor == 'workbench.editor.browser' && !sideBarFocus && !auxiliaryBarFocus && !panelFocus"
    },
    {
        "key": "ctrl+numpad5",
        "command": "wordPage.chatSelectionToClaude",
        "when": "activeWebviewPanelId == 'claudeVSCodePanel' && !sideBarFocus && !auxiliaryBarFocus && !panelFocus"
    },
    {
        "key": "ctrl+numpad5",
        "command": "wordPage.chatSelectionToClaude",
        "when": "focusedView == 'claudeVSCodeSidebar' || focusedView == 'claudeVSCodeSidebarSecondary' || !editorAreaFocus && !sideBarFocus && !auxiliaryBarFocus && !panelFocus && !inputFocus"
    },
    {
        "key": "ctrl+numpad1",
        "command": "wordPage.toClaudeTab"
    },
    {
        "key": "ctrl+numpad1",
        "command": "wordPage.editorSelectionToClaude",
        "args": { "target": "tab" },
        "when": "editorTextFocus && editorHasSelection"
    },
    {
        "key": "ctrl+numpad1",
        "command": "wordPage.selectionToClaude",
        "args": { "target": "tab" },
        "when": "activeCustomEditorId == 'quarto.visualEditor' && !sideBarFocus && !auxiliaryBarFocus && !panelFocus"
    },
    {
        "key": "ctrl+numpad1",
        "command": "wordPage.browserToClaude",
        "args": { "target": "tab" },
        "when": "activeEditor == 'workbench.editor.browser' && !sideBarFocus && !auxiliaryBarFocus && !panelFocus"
    },
    {
        "key": "ctrl+numpad1",
        "command": "wordPage.chatSelectionToClaude",
        "args": { "target": "tab" },
        "when": "activeWebviewPanelId == 'claudeVSCodePanel' && !sideBarFocus && !auxiliaryBarFocus && !panelFocus"
    },
    {
        "key": "ctrl+numpad1",
        "command": "wordPage.chatSelectionToClaude",
        "args": { "target": "tab" },
        "when": "focusedView == 'claudeVSCodeSidebar' || focusedView == 'claudeVSCodeSidebarSecondary' || !editorAreaFocus && !sideBarFocus && !auxiliaryBarFocus && !panelFocus && !inputFocus"
    },
    {
        "key": "ctrl+numpad9",
        "command": "quarto.editInSourceMode",
        "when": "activeCustomEditorId == 'quarto.visualEditor'"
    },
    {
        "key": "ctrl+numpad9",
        "command": "quarto.editInVisualMode",
        "when": "editorTextFocus && editorLangId == quarto"
    },
    {
        "key": "ctrl+numpad6",
        "command": "workbench.action.toggleAuxiliaryBar"
    },
    {
        "key": "ctrl+numpad7",
        "command": "runCommands",
        "args": {
            "commands": [
                "workbench.action.focusSecondEditorGroup",
                "claude-vscode.primaryEditor.open"
            ]
        }
    },
    {
        "key": "ctrl+numpad8",
        "command": "workbench.action.chat.open"
    },
    {
        "key": "ctrl+alt+b",
        "command": "-workbench.action.toggleAuxiliaryBar"
    },
    {
        "key": "ctrl+enter",
        "command": "rPipeIndent.runStatement",
        "when": "editorTextFocus && editorLangId == r && !editorReadonly"
    },
    {
        "key": "shift+enter",
        "command": "runCommands",
        "args": { "commands": ["cursorDown", "cursorLineEnd"] },
        "when": "editorTextFocus && editorLangId == r && !suggestWidgetVisible"
    },
    {
        "key": "shift+alt+enter",
        "command": "runCommands",
        "args": { "commands": ["cursorUp", "cursorLineEnd"] },
        "when": "editorTextFocus && editorLangId == r && !suggestWidgetVisible"
    },
    {
        "key": "ctrl+numpad2",
        "command": "editor.action.dirtydiff.next",
        "when": "editorTextFocus"
    },
    {
        "key": "ctrl+numpad3",
        "command": "workbench.action.browser.open",
        "args": {
            "url": "https://claude.ai/artifact/HaPMjTNjwQDy4p8XDqQtMe",
            "reuseUrlFilter": "https://claude.ai/artifact/HaPMjTNjwQDy4p8XDqQtMe",
            "openToSide": true
        }
    }
]
