// Place your key bindings in this file to override the defaults
[
    {
        "key": "ctrl+alt+r",
        "command": "r.createRTerm"
    },
    {
        "key": "ctrl+m",
        "command": "-editor.action.toggleTabFocusMode"
    },
    {
        "key": "ctrl+shift+m",
        "command": "rPipeIndent.insertPipe",
        "when": "editorTextFocus && editorLangId == r && !editorReadonly"
    },
    {
        "key": "ctrl+numpad4",
        "command": "claude-vscode.primaryEditor.open"
    },
    {
        "key": "ctrl+numpad5",
        "command": "claude-vscode.sidebar.open"
    },
    {
        "key": "ctrl+numpad5",
        "command": "runCommands",
        "args": {
            "commands": [
                "claude-vscode.sidebar.open",
                "claude-vscode.insertAtMention"
            ]
        },
        "when": "editorTextFocus && editorHasSelection"
    },
    {
        "key": "ctrl+numpad5",
        "command": "wordPage.selectionToClaude",
        "when": "activeCustomEditorId == 'quarto.visualEditor' && !sideBarFocus && !auxiliaryBarFocus && !panelFocus"
    },
    {
        "key": "ctrl+numpad5",
        "command": "wordPage.browserToClaude",
        "when": "activeEditor == 'workbench.editor.browser' && !sideBarFocus && !auxiliaryBarFocus && !panelFocus"
    },
    {
        "key": "ctrl+numpad6",
        "command": "workbench.action.toggleAuxiliaryBar"
    },
    {
        "key": "ctrl+numpad7",
        "command": "runCommands",
        "args": {
            "commands": [
                "workbench.action.focusSecondEditorGroup",
                "claude-vscode.primaryEditor.open"
            ]
        }
    },
    {
        "key": "ctrl+numpad8",
        "command": "workbench.action.chat.open"
    },
    {
        "key": "ctrl+alt+b",
        "command": "-workbench.action.toggleAuxiliaryBar"
    },
    {
        "key": "ctrl+enter",
        "command": "rPipeIndent.runStatement",
        "when": "editorTextFocus && editorLangId == r && !editorReadonly"
    },
    {
        "key": "ctrl+numpad2",
        "command": "editor.action.dirtydiff.next",
        "when": "editorTextFocus"
    },
    {
        "key": "ctrl+numpad3",
        "command": "workbench.action.browser.open",
        "args": {
            "url": "https://claude.ai/artifact/HaPMjTNjwQDy4p8XDqQtMe",
            "reuseUrlFilter": "https://claude.ai/artifact/HaPMjTNjwQDy4p8XDqQtMe",
            "openToSide": true
        }
    }
]
