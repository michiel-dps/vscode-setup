{
    // Startup screen off since 19 Nov 2026: Windows crashed (blue screen 0x1C6, a driver fault)
    // seconds after it opened full screen. Recommended: leave it off (note, section 5b)
    "startupScreen.enabled": false,
    // Off since 16 Nov 2026: VS Code's experimental edit statistics kept a full copy of an open
    // document after every change; with the paper on the Word Page that filled the window's
    // memory until it crashed ("renderer process gone (reason: oom)", five times that day)
    "telemetry.editStats.enabled": false,
    // Ctrl+1 in the terminal goes back to the script (keybindings.json), not to R (18 Nov 2026)
    "terminal.integrated.commandsToSkipShell": [
        "workbench.action.focusActiveEditorGroup"
    ],
    "git.ignoredRepositories": [
        "C:\\Users\\<you>\\<Dropbox>\\<name>\\<project>\\code\\<co-author>"
    ],
    "files.readonlyInclude": {
        "**/<project>/code/<co-author>/**": true
    },
    "claudeCode.hideOnboarding": true,
    "diffEditor.renderSideBySide": false,
    "diffEditor.ignoreTrimWhitespace": false,
    "diffEditor.renderGutterMenu": true,
    "workbench.colorTheme": "idleFingers",
    "files.autoSave": "afterDelay",
    "files.autoSaveDelay": 100,
    "claudeCode.preferredLocation": "sidebar",
    "security.workspace.trust.untrustedFiles": "open",
    "editor.bracketPairColorization.enabled": false,
    "editor.autoClosingOvertype": "always",
    "editor.autoClosingDelete": "always",
    "editor.inlayHints.enabled": "offUnlessPressed",
    "editor.minimap.enabled": false,
    "[r]": {
        "editor.inlineSuggest.enabled": false,
        "editor.tabSize": 2,
        "editor.insertSpaces": true,
        "editor.detectIndentation": false,
        // No small colour square before "darkred": Color Highlight paints the word's background instead (18 Nov 2026)
        "editor.colorDecorators": false
    },
    // Color Highlight add-on (naumovs.color-highlight): colour names and #hex codes get a border in their colour, in R files only
    "color-highlight.markerType": "outline",
    "color-highlight.matchWords": true,
    "color-highlight.languages": [
        "r"
    ],
    "r.consolePath": "C:\\Program Files\\R\\R-4.6.1\\bin\\R.exe",
    "r.executablePath": "C:\\Program Files\\R\\R-4.6.1\\bin\\R.exe",
    "r.bracketedPaste": true,
    "r.sessionWatcher": true,
    "r.plot.backend": "httpgd",
    // The plot fills the whole R Plot tab and is redrawn when the tab changes size (18 Nov 2026).
    // The strip of small earlier plots is hidden then: the toolbar's full window button shows it.
    "r.plot.defaults.fullWindowMode": true,
    // Data viewer, R Plot, R Help and the htmlwidget viewer open beside the script, in this
    // window. The default "Two" counts the groups of a floating window too, so with one
    // group here they landed in a floating window (18 Nov 2026). Fix 7 of patch-r-extension.pl
    // goes first: a new data or plot tab joins a group that already shows one, in any window.
    "r.session.viewers.viewColumn": {
        "plot": "Beside",
        "browser": "Active",
        "viewer": "Beside",
        "pageViewer": "Active",
        "view": "Beside",
        "helpPanel": "Beside"
    },
    "workbench.editorAssociations": {
        "*.copilotmd": "vscode.markdown.preview.editor",
        "*.md": "vscode.markdown.preview.editor",
        // A .qmd opens as the Word Page (Quarto's visual editor). Not "editor: visual" in the header: with that, Quarto throws you back to the page when you switch to the text
        "*.qmd": "quarto.visualEditor"
    },
    "editor.tokenColorCustomizations": {
        "[idleFingers]": {
            "textMateRules": [
                {
                    "scope": "source",
                    "settings": {
                        "foreground": "#FFFFFF",
                        "fontStyle": ""
                    }
                },
                {
                    "scope": [
                        "meta.function-call.r",
                        "support.function.r"
                    ],
                    "settings": {
                        "foreground": "#A7C7E7",
                        "fontStyle": ""
                    }
                },
                {
                    "scope": "meta.function-call.arguments.r",
                    "settings": {
                        "foreground": "#FFFFFF",
                        "fontStyle": ""
                    }
                },
                {
                    "scope": [
                        "punctuation.definition.arguments",
                        "punctuation.definition.parameters",
                        "punctuation.section.parameters",
                        "punctuation.section.brackets"
                    ],
                    "settings": {
                        "foreground": "#DA70D6",
                        "fontStyle": ""
                    }
                },
                {
                    "scope": "meta.function.r keyword.control.r",
                    "settings": {
                        "foreground": "#A7C7E7",
                        "fontStyle": ""
                    }
                },
                {
                    "scope": [
                        "entity.name.function.r",
                        "variable.parameter",
                        "meta.function.parameters.r"
                    ],
                    "settings": {
                        "foreground": "#FFFFFF",
                        "fontStyle": ""
                    }
                },
                {
                    "scope": "constant.numeric",
                    "settings": {
                        "foreground": "#F6E3A1",
                        "fontStyle": ""
                    }
                },
                {
                    "scope": "punctuation.section.block",
                    "settings": {
                        "foreground": "#C3B1E1",
                        "fontStyle": ""
                    }
                },
                {
                    "scope": [
                        "comment",
                        "variable",
                        "variable.parameter",
                        "variable.other",
                        "entity",
                        "entity.other",
                        "support",
                        "storage",
                        "keyword",
                        "string",
                        "meta",
                        "markup"
                    ],
                    "settings": {
                        "fontStyle": ""
                    }
                }
            ]
        }
    },
    "workbench.colorCustomizations": {
        "[idleFingers]": {
            "statusBar.background": "#323232",
            "statusBar.foreground": "#ffffff",
            "statusBar.noFolderBackground": "#323232",
            "statusBar.debuggingBackground": "#323232",
            "statusBar.debuggingForeground": "#ffffff",
            "statusBarItem.remoteBackground": "#3b3b3b",
            "statusBarItem.remoteForeground": "#ffffff",
            "modernTab.activeBackground": "#FFD16640",
            "editorGroup.border": "#FFD16640"
        }
    },
    "editor.fontLigatures": false,
    "terminal.integrated.enablePersistentSessions": false,
    "editor.parameterHints.enabled": false,
    "terminal.integrated.enableMultiLinePasteWarning": "never",
    "chat.viewSessions.orientation": "stacked",
    "chat.editing.revealNextChangeOnResolve": false,
    "explorer.confirmDelete": false,
    // Quarto's own spell check off: Claude checks spelling on the page (Word Page add-on, 16 Nov 2026)
    "quarto.visualEditor.spelling": false,
    // Word Page: no dashed "page 2, page 3" lines where the pages of the PDF start (16 Nov 2026)
    "wordPage.pageEnds": false,
    "editor.largeFileOptimizations": false,
    // Plain start (Start menu, taskbar icon): reopen every window of the last session. Opening one folder: only that folder
    "window.restoreWindows": "all",
    // The built-in browser (Ctrl+Numpad3, the Tutor) keeps its login and stored progress across restarts and folders
    "workbench.browser.dataStorage": "global",
    "git.autofetch": true,
    "window.confirmSaveUntitledWorkspace": false,
    "claudeCode.focusView": true
}
