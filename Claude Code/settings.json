{
  "env": {
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1"
  },
  "permissions": {
    "allow": [
      "WebFetch(domain:rdpackages.github.io)"
    ],
    "defaultMode": "auto"
  },
  "model": "opus[1m]",
  "skillOverrides": {
    "docs": "off",
    "docx": "off",
    "pdf": "off",
    "pptx": "off",
    "xlsx": "off",
    "morning": "off",
    "import-memory": "off",
    "skill-creator": "off",
    "deep-research": "off",
    "google-workspace": "off",
    "chrome-browser": "off",
    "built-in-browser": "off",
    "computer-use": "off"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"C:/Users/<you>/AppData/Local/Programs/Python/Python312/python.exe\" -I \"C:/Users/<you>/.claude/review/review.py\" pre"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"C:/Users/<you>/AppData/Local/Programs/Python/Python312/python.exe\" -I \"C:/Users/<you>/.claude/review/review.py\" post"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"C:/Users/<you>/AppData/Local/Programs/Python/Python312/python.exe\" -I \"C:/Users/<you>/.claude/review/review.py\" failed"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"C:/Users/<you>/AppData/Local/Programs/Python/Python312/python.exe\" -I \"C:/Users/<you>/.claude/review/review.py\" stop"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "data@synced": false
  },
  "modelSettings": {
    "claude-opus-5": {
      "effortLevel": "xhigh"
    },
    "claude-fable-5-1": {
      "effortLevel": "xhigh"
    },
    "claude-opus-5-5": {
      "effortLevel": "xhigh"
    }
  },
  "autoUpdatesChannel": "latest",
  "theme": "dark-ansi",
  "agentPushNotifEnabled": true
}
